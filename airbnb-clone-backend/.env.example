# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/airbnb-clone

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string

# JWT expiry (e.g. 1d, 12h, 7d)
JWT_EXPIRES_IN=7d

# Server port (Heroku sets this automatically, this is the local fallback)
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
